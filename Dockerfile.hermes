FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[openai,silero,turn-detector]"
COPY examples/Dockerfile-example ./examples/
CMD ["python", "-m", "agents.worker", "dev"]
